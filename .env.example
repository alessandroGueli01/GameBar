# PostgreSQL URIs for each service
POSTGRES_USER_URI=postgres://postgres:postgres_password@127.0.0.1:5432/user_db
POSTGRES_GAME_URI=postgres://postgres:postgres_password@127.0.0.1:5432/game_db
POSTGRES_MATCH_URI=postgres://postgres:postgres_password@127.0.0.1:5432/match_db
POSTGRES_TOURNAMENT_URI=postgres://postgres:postgres_password@127.0.0.1:5432/tournament_db
POSTGRES_STATISTICS_URI=postgres://postgres:postgres_password@127.0.0.1:5432/statistics_db

# JWT Secret for authentication
JWT_SECRET=change_this_secret_in_production

# MQTT Broker URL
MQTT_BROKER=mqtt://test.mosquitto.org

# Internal URL for service-to-service communication
API_GATEWAY_INTERNAL=http://localhost:3005
